# ============================================================
#  Madad Vision AI — Environment Configuration
#  Copy this file to .env and fill in the values before running
# ============================================================

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=madad
POSTGRES_PASSWORD=madad_secret_2024
POSTGRES_DB=madad_vision
DATABASE_URL=postgresql://madad:madad_secret_2024@localhost:5432/madad_vision

# ─── Auth (JWT) ─────────────────────────────────────────────
# MUST change before production! Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-secure-32-char-secret-NOW
JWT_REFRESH_SECRET=change-this-refresh-secret-also-NOW
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_EXPIRES_IN=15m

# Generate a SEPARATE 32-byte hex key; never reuse a JWT signing secret.
CAMERA_ENCRYPTION_KEY=
CAMERA_ENCRYPTION_KEY_ID=primary
CAMERA_ENCRYPTION_PREVIOUS_KEYS={}
# Disable legacy reads only after migrating existing camera records.
ALLOW_LEGACY_CAMERA_CREDENTIALS=true
ALLOW_SELF_REGISTRATION=false

# ─── Cache (Valkey / Redis-compatible) ─────────────────────
CACHE_URL=redis://localhost:6379
CACHE_TTL=30

# ─── CORS ───────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── AI Engine ──────────────────────────────────────────────
AI_ENGINE_URL=http://localhost:8000
BACKEND_REST_URL=http://localhost:3001
BACKEND_WS_URL=http://localhost:3001
MODEL_CONFIDENCE_THRESHOLD=0.55
SNAPSHOT_DIR=./snapshots

# ─── Storage ────────────────────────────────────────────────
STORAGE_PATH=./snapshots

# ─── Web App ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# ─── MinIO / S3 ─────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=madad-snapshots

# ─── AI Engine Authentication ───────────────────────────────
AI_ENGINE_KEY=change-this-to-a-secure-ai-engine-key

# ─── SMTP / Email ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@madadvision.ai

# ─── Environment ────────────────────────────────────────────
NODE_ENV=development

# ─── Web App URL (used by backend for OAuth redirect) ────────
WEB_URL=http://localhost:3000

# ─── Google OAuth 2.0 ───────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
